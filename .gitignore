# Pre-bootstrap local state (see ./stackctl --state); never committed.
/state/

# Nix build results
result
result-*

# Real, account-specific variable values (never committed; ./stackctl passes
# them with --var-file when present).
environments/*.vars.json

# age identities / private keys — never committed.
*.key
*.agekey
id_ed25519
id_rsa
keys.txt

# nivis's local state document and its advisory lock. State lives in S3; these
# are the local fallback and a lock nivis writes next to its default --state
# path, which is not always under state/.
nivis.state.json
*.state.json
*.state.json.lock
*.state.json.ledger
